# Copy this file to .env and fill values from:
# Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred current server-side key:
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
# Legacy alternative (leave blank when using SUPABASE_SECRET_KEY):
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_SCHEMA=public
SUPABASE_PRODUCTS_TABLE=retailer_products
SUPABASE_PRICE_HISTORY_TABLE=retailer_price_history
SUPABASE_RUNS_TABLE=retailer_scrape_runs
DATABASE_BATCH_SIZE=100
DATABASE_TIMEOUT_SECONDS=45
DATABASE_SYNC_REQUIRED=true

# Needed by the hosted Nykaa cron job. Paste the complete product-list API
# request copied as cURL (bash), as one environment-variable value.
NYKAA_CURL_COMMAND=
# Alternative when running locally or with a Render secret file:
NYKAA_CURL_FILE=

# Optional overrides for Tira's public storefront application credentials.
TIRA_APPLICATION_ID=
TIRA_APPLICATION_TOKEN=

# Makes the hosted product viewer default to Supabase instead of local files.
HOSTED_DASHBOARD=false

# Password gate for the hosted app. Leave blank locally to run without a
# prompt; a deployment with HOSTED_DASHBOARD=true refuses to serve without it.
APP_PASSWORD=
